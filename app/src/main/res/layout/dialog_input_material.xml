<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/item_background"
    android:elevation="8dp">

    <RelativeLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/fileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/moreOptionsIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more"
            android:padding="2dp" />

        <TextView
            android:id="@+id/languageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/moreOptionsIcon"
            android:layout_centerVertical="true"
            android:text=".txt"
            android:textColor="#808080"
            android:textSize="14sp"
            android:padding="4dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_toStartOf="@id/languageIndicator"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_indicator_background"/>
    </RelativeLayout>

    <EditText
        android:id="@+id/inputText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter title"
        android:padding="12dp"
        android:textSize="16sp"
        android:backgroundTint="@color/white"
        android:textColorHint="@color/black"
        android:textColor="@color/black"
        android:inputType="text"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lineNumbers"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="#808080"
                android:textSize="12sp"
                android:gravity="end"
                android:fontFamily="monospace"
                android:background="#F5F5F5"
                android:lineSpacingExtra="4dp"
                android:text="1\n"/>

            <EditText
                android:id="@+id/contentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="14sp"
                android:backgroundTint="@color/white"
                android:textColorHint="@color/black"
                android:textColor="@color/black"
                android:inputType="textMultiLine|textNoSuggestions"
                android:gravity="top"
                android:minHeight="200dp"
                android:background="@drawable/edit_text_background"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:scrollbars="none"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="16dp">

        <ImageView
            android:id="@+id/saveIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:src="@drawable/plus"
            android:contentDescription="Save"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/terminalSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:background="#1A000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/terminalPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:typeface="monospace"
                android:textColor="#808080" />

            <EditText
                android:id="@+id/terminalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@null"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:typeface="monospace"
                android:inputType="text"
                android:imeOptions="actionSend" />

            <TextView
                android:id="@+id/terminalOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="100dp"
                android:textSize="14sp"
                android:textColor="#808080"
                android:typeface="monospace" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
